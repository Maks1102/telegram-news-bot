# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=9128098993:AAHegwTzdZYNmPjrw_1_sTiSeYD0KKD6LVw
# ID чата для еженедельной рассылки (узнать можно командой /start боту
# или через @userinfobot / @getidsbot). Для группы/канала — отрицательное число.
CHAT_ID=7996005342

# --- RSS-источники: только IT-индустрия (через запятую, без пробелов после запятых) ---
# РФ: Habr, vc.ru, 3DNews, CNews, Журнал "Код", Хакер, Компьютерра
RSS_FEEDS=https://habr.com/ru/rss/all/,https://vc.ru/rss,https://3dnews.ru/news/rss,https://www.cnews.ru/inc/rss/news.xml,https://xakep.ru/rss,https://www.computerra.ru/rss/,https://thecode.media/feed/

# --- Расписание (APScheduler CronTrigger) ---
# День недели: mon..sun (или 0..6, где 0 = понедельник)
SCHEDULE_DAY=mon
# Время отправки, HH:MM (21:00 поставлено для теста — верните 09:00, когда всё проверите)
SCHEDULE_TIME=07:30
# Часовой пояс (tz database)
TIMEZONE=Europe/Moscow

# --- Дайджест и хранилище ---
DATABASE_PATH=data/news.db
DIGEST_SIZE=10
RETENTION_DAYS=90

# --- HTTP-запросы к RSS ---
REQUEST_TIMEOUT=15

# --- Логирование ---
LOG_LEVEL=INFO
